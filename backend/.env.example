# Porta do servidor (default 3000)
PORT=3000
# Ambientes: development | production
NODE_ENV=development
# Origens CORS permitidas (separadas por vírgula). Em development, `*` aceita qualquer origem.
CORS_ORIGINS=*
# APIs externas (o backend é o único consumidor — ver TechSpec)
GEOCODING_API_URL=https://geocoding-api.open-meteo.com/v1/search
FORECAST_API_URL=https://api.open-meteo.com/v1/forecast
REVERSE_GEOCODING_API_URL=https://api.bigdatacloud.net/data/reverse-geocode-client
